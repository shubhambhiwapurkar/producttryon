# "gemini", "composite" or "mock". Default: gemini when GEMINI_API_KEY is set, otherwise composite.
TRYON_RENDERER=
GEMINI_API_KEY=
# Check the current image model ID at https://ai.google.dev/gemini-api/docs/image-generation
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
# Self-serve onboarding at /onboard: open to anyone, or only with an invite code
OPEN_SIGNUP=false
INVITE_CODES=
# Key for creating stores (POST /api/platform/stores)
PLATFORM_ADMIN_KEY=change-me
# Defaults: DATA_DIR=data and a SQLite database inside it. Leave unset for docker-compose,
# which mounts the data folder at /data.
# DATA_DIR=data
# Customer selfies and results are deleted after this many days
RETENTION_DAYS=7
# docker-compose.yml only: the domain Caddy gets an HTTPS certificate for.
# No domain yet? Use your server IP with dashes + .sslip.io, e.g. 141-148-12-34.sslip.io
DOMAIN=
# Load the "Maison Aurelia" demo store at /s/demo on start (remove for production)
SEED_DEMO=1
